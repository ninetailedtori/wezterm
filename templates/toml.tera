---
whiskers:
  version: "^2.8.0"
  matrix:
    - flavor
  filename: "dist/catppuccin-{{ flavor.identifier }}.toml"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
[colors]
ansi = [
  '{{ self::rgb(col=flavor.ansi_colors.black) }}',
  '{{ self::rgb(col=flavor.ansi_colors.red) }}',
  '{{ self::rgb(col=flavor.ansi_colors.green) }}',
  '{{ self::rgb(col=flavor.ansi_colors.yellow) }}',
  '{{ self::rgb(col=flavor.ansi_colors.blue) }}',
  '{{ self::rgb(col=flavor.ansi_colors.magenta) }}',
  '{{ self::rgb(col=flavor.ansi_colors.cyan) }}',
  '{{ self::rgb(col=flavor.ansi_colors.white) }}',
]
background = '{{ base.hex }}'
brights = [
  '{{ self::rgb(col=flavor.ansi_colors.bright_black) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_red) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_green) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_yellow) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_blue) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_magenta) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_cyan) }}',
  '{{ self::rgb(col=flavor.ansi_colors.bright_white) }}',
]
compose_cursor = '{{ flamingo.hex }}'
cursor_bg = '{{ rosewater.hex }}'
cursor_border = '{{ rosewater.hex }}'
cursor_fg = '{{ crust.hex }}'
foreground = '{{ text.hex }}'
scrollbar_thumb = '{{ surface2.hex }}'
selection_bg = '{{ surface2.hex }}'
selection_fg = '{{ text.hex }}'
split = '{{ overlay0.hex }}'
visual_bell = '{{ surface0.hex }}'

[colors.indexed]
16 = '{{ peach.hex }}'
17 = '{{ rosewater.hex }}'

[colors.tab_bar]
background = '{{ crust.hex }}'
inactive_tab_edge = '{{ surface0.hex }}'

[colors.tab_bar.active_tab]
bg_color = '{{ mauve.hex }}'
fg_color = '{{ crust.hex }}'
intensity = 'Normal'
italic = false
strikethrough = false
underline = 'None'

[colors.tab_bar.inactive_tab]
bg_color = '{{ mantle.hex }}'
fg_color = '{{ text.hex }}'
intensity = 'Normal'
italic = false
strikethrough = false
underline = 'None'

[colors.tab_bar.inactive_tab_hover]
bg_color = '{{ base.hex }}'
fg_color = '{{ text.hex }}'
intensity = 'Normal'
italic = false
strikethrough = false
underline = 'None'

[colors.tab_bar.new_tab]
bg_color = '{{ surface0.hex }}'
fg_color = '{{ text.hex }}'
intensity = 'Normal'
italic = false
strikethrough = false
underline = 'None'

[colors.tab_bar.new_tab_hover]
bg_color = '{{ surface1.hex }}'
fg_color = '{{ text.hex }}'
intensity = 'Normal'
italic = false
strikethrough = false
underline = 'None'

[metadata]
aliases = []
author = 'Catppuccin Org'
name = 'Catppuccin {{ flavor.name }}'
